# Local Development Environment
# Use this for local development with docker-compose.local.yml

# Public domain / routing (local)
PUBLIC_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://backend:8000
AUTH_SERVICE_URL=http://auth-service:8001
FILE_SERVICE_URL=http://file-service:8002
PDF_SERVICE_URL=http://pdf-service:8003
AI_SERVICE_URL=http://ai-service:8004
REPORT_SERVICE_URL=http://report-service:8005

# Keycloak public + internal wiring (local)
KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=airco-insights
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend-app
KEYCLOAK_REALM=airco-insights
KEYCLOAK_CLIENT_ID=frontend-app
KEYCLOAK_CLIENT_SECRET=airco-frontend-secret-2024-secure-key-abc123xyz
AUTH_SERVICE_KEYCLOAK_CLIENT_ID=frontend-app
AUTH_SERVICE_KEYCLOAK_CLIENT_SECRET=airco-frontend-secret-2024-secure-key-abc123xyz
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KC_HTTP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
KC_HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENABLE_KEYCLOAK_TOTP=false

# Application database (local)
APP_DB_NAME=airco_app
APP_DB_USER=airco
APP_DB_PASSWORD=airco123
AUTH_DATABASE_URL=postgresql://postgres.zesqwvycakqrrtdunzlt:4IBNX7HW0Ynz6Ur6@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.zesqwvycakqrrtdunzlt:4IBNX7HW0Ynz6Ur6@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET_KEY=local-dev-jwt-secret-change-in-production

# Object storage / queues / cache (local - using default MinIO credentials)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=airco-files
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# AI provider keys (replace with your actual keys)
GROQ_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
CLAUDE_API_KEY=REPLACE_ME
GOOGLE_API_KEY=REPLACE_ME
NEXT_PUBLIC_AIRCO_API_KEY=REPLACE_ME

# SSL (not needed for local development)
# SSL_CERTS_DIR=
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
CLAUDE_MODEL=claude-3-sonnet-20240229

# Optional service tuning
DEBUG=true
STORAGE_TYPE=minio
MAX_FILE_SIZE_MB=20
PROCESSING_TIMEOUT_SECONDS=300
DEFAULT_ANALYSIS_TYPE=categorization
DEFAULT_REPORT_FORMAT=excel

# Data retention policy (7-day retention for raw PDFs and Excel reports)
DATA_RETENTION_DAYS=7
RETENTION_ENABLED=true
RETENTION_SWEEP_INTERVAL_MINUTES=60
