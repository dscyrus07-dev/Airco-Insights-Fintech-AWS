# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Backend
BACKEND_URL=http://localhost:8000
CLAUDE_API_KEY=your-claude-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your-google-api-key-here

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=airco-insights
KEYCLOAK_CLIENT_ID=frontend-app
KEYCLOAK_CLIENT_SECRET=airco-frontend-secret
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak123

# Auth Service Keycloak Client
AUTH_SERVICE_KEYCLOAK_CLIENT_ID=frontend-app
AUTH_SERVICE_KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AIRCO_API_KEY=your-airco-api-key-here
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=airco-insights
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend-app

# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
FILE_SERVICE_URL=http://localhost:8002
PDF_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
REPORT_SERVICE_URL=http://localhost:8005
